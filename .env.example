# Server & Web App Port
PORT=3000

# Client API Base URL (leave empty for same-origin /api proxy)
VITE_API_URL=

# Copernicus Data Space Ecosystem (CDSE) Configuration
# The OData Catalog API allows public metadata discovery and footprint search without credentials
COPERNICUS_CDSE_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products

# Optional credentials for authenticated requests or downloading full Sentinel-2 .SAFE product files (not required for search/metadata)
COPERNICUS_CDSE_CLIENT_ID=
COPERNICUS_CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_ACCESS_TOKEN=
